{
  "opencollection": "1.0.0",
  "info": {
    "name": "Yoda core admin provenance API",
    "version": "2.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "yoda_session",
      "value": "{{yoda_session}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "provenance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Return formatted provenance log of a collection.\n",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://portal.yoda.test/api/provenance_log",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Return formatted provenance log of a collection.\n"
        }
      ]
    }
  ],
  "bundled": true
}