{
  "opencollection": "1.0.0",
  "info": {
    "name": "Yoda core admin schema_transformation API",
    "version": "2.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "yoda_session",
      "value": "{{yoda_session}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "schema_transformation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Transform a yoda-metadata file in the given collection to the active schema.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://portal.yoda.test/api/transform_metadata",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Transform a yoda-metadata file in the given collection to the active schema."
        }
      ]
    }
  ],
  "bundled": true
}